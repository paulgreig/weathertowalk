{
  "name": "Weather to Walk (Go + Android)",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "features": {
    "ghcr.io/devcontainers/features/go:1": {
      "version": "1.25.6"
    }
  },
  "postCreateCommand": "go install golang.org/x/mobile/cmd/gomobile@latest && gomobile init && go install github.com/golangci/golangci-lint/v2/cmd/golangci-lint@latest",
  "remoteEnv": {
    "ANDROID_HOME": "/opt/android-sdk",
    "ANDROID_SDK_ROOT": "/opt/android-sdk",
    "ANDROID_NDK_HOME": "/opt/android-sdk/ndk/21.4.7075529",
    "PATH": "${containerEnv:PATH}:${containerEnv:HOME}/go/bin"
  },
  "customizations": {
    "vscode": {
      "extensions": ["golang.go"]
    }
  }
}
